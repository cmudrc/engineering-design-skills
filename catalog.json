{
  "framework": {
    "id": "ulrich-eppinger-6e",
    "name": "Ulrich and Eppinger, Product Design and Development",
    "edition": 6,
    "year": 2016,
    "reference": "Chapter 2, pp. 13–16, Exhibits 2-2 and 2-3; Exhibit 1-4, p. 9.",
    "mapping_note": "Phase names follow the book. Skill memberships are this library’s many-to-many interpretation of useful application contexts, not a claim that the book assigns these agent skills."
  },
  "phases": [
    {
      "id": 0,
      "name": "Planning",
      "purpose": "Define the opportunity and the project mission before committing to development.",
      "output": "Mission statement, target users, business goals, assumptions, and constraints."
    },
    {
      "id": 1,
      "name": "Concept Development",
      "purpose": "Understand needs, develop specifications, and generate, select, and test product concepts.",
      "output": "Selected concept, supporting evidence, specifications, and a downstream development plan."
    },
    {
      "id": 2,
      "name": "System-Level Design",
      "purpose": "Define the architecture, subsystems, interfaces, and initial production and assembly approach.",
      "output": "System layout, subsystem requirements, interface definitions, and preliminary assembly plan."
    },
    {
      "id": 3,
      "name": "Detail Design",
      "purpose": "Specify parts, materials, geometry, tolerances, purchased components, and production processes.",
      "output": "Buildable design definition, drawings or models, component specifications, and process documentation."
    },
    {
      "id": 4,
      "name": "Testing and Refinement",
      "purpose": "Evaluate developed product versions against intended performance and use, then resolve needed changes.",
      "output": "Test evidence, resolved design changes, and confidence in product and process readiness."
    },
    {
      "id": 5,
      "name": "Production Ramp-Up",
      "purpose": "Use the intended production system, train operators, and resolve problems found in early output.",
      "output": "Evaluated early production, stabilized operations, and launch-readiness evidence."
    }
  ],
